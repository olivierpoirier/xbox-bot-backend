{
  "name": "music-bot",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs --tunnel",
    "dev:local": "node scripts/dev.mjs",
    "dev:tunnel": "node scripts/dev.mjs --tunnel",
    "dev:stable-tunnel": "node scripts/dev.mjs --stable-tunnel",
    "tunnel:login": "cloudflared tunnel login",
    "tunnel:create": "cloudflared tunnel create music-bot",
    "tunnel:list": "cloudflared tunnel list",
    "tunnel:route": "cloudflared tunnel route dns music-bot",
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:frontend:vercel": "npm --prefix frontend run build:vercel"
  }
}
